# ==========================================================================
# OneisOk Legal Consultancy — Apache config for cPanel shared hosting
# Upload this file to public_html/ alongside the site.
# ==========================================================================

Options -Indexes
DirectoryIndex index.html

# --------------------------------------------------------------------------
# HTTPS + canonical host
# Uncomment the www block that matches your preference AFTER your SSL
# certificate is active in cPanel (AutoSSL). Leaving both commented is safe.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- Option A: force non-www (recommended for a subdomain like legal.*) ---
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # --- Option B: force www ---
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteCond %{HTTP_HOST} !^localhost [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # --------------------------------------------------------------------
  # Clean URLs: /services  ->  /services.html
  # Redirect the .html form to the extensionless one so only one URL
  # is ever indexed, then rewrite it back internally.
  #
  # QSA is required on the redirect: service-detail and get-quote are
  # driven by ?s=<slug>, and without it the query is dropped and the
  # page loads with nothing to hydrate from.
  # index.html redirects to / rather than /index, which is not a
  # canonical URL on this site.
  # --------------------------------------------------------------------
  # partials/ and data/ are fetched by JS at their real paths. Redirecting
  # them to extensionless URLs costs every page two extra round-trips, so
  # they are excluded from the canonical-URL redirect below.
  RewriteRule ^(partials|data)/ - [L]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L,QSA]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L,QSA]
</IfModule>

# --------------------------------------------------------------------------
# Custom error pages
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# Compression
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
  AddOutputFilterByType DEFLATE font/woff2 application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# Caching — long for fingerprinted assets, short for HTML
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/json          "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ---- Security headers ----
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  # Enable once HTTPS is confirmed working:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  Header unset X-Powered-By
  Header always unset Server
</IfModule>

# --------------------------------------------------------------------------
# MIME types
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript          js
  AddType application/json                json
  AddType image/svg+xml                   svg svgz
  AddType font/woff2                      woff2
  AddType image/webp                      webp
  AddType image/avif                      avif
  AddType text/cache-manifest             appcache
</IfModule>

AddDefaultCharset UTF-8

# --------------------------------------------------------------------------
# Block access to sensitive files
# --------------------------------------------------------------------------
<FilesMatch "(^\.|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|swp|md)$)">
  Require all denied
</FilesMatch>
